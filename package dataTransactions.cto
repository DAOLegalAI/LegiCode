package dataTransactions

import (
    "encoding/json"
    "fmt"
    "strings"

    "github.com/hyperledger/fabric-contract-api-go/contractapi"
    shell "github.com/ipfs/go-ipfs-api" // assuming you have an IPFS shell running
)

// DataTransaction represents a transaction record in the ledger
type DataTransaction struct {
    TransactionID    string `json:"transactionId"`
    AssetID          string `json:"assetId"`
    TransactionType  string `json:"transactionType"`
    TransactionValue FabToken `json:"transactionValue"`
    IPFSCID          string `json:"ipfsCID"` // IPFS Content Identifier for the transaction data

}

// DataTransactionContract contains all functions related to data transactions
type DataTransactionContract struct {
    contractapi.Contract
}

// Assuming you have a running IPFS node accessible
var sh = shell.NewShell("localhost:5001")

// StoreTransactionDataOnIPFS handles storing transaction-related data on IPFS and updating the ledger with the CID
func (dtc *DataTransactionContract) StoreTransactionDataOnIPFS(ctx contractapi.TransactionContextInterface, transactionData string, transactionId string) error {
    // Store data on IPFS
    cid, err := sh.Add(strings.NewReader(transactionData))
    if err != nil {
        return fmt.Errorf("failed to store data on IPFS: %v", err)
    }

    // Retrieve the existing transaction record from the ledger using the transaction ID
    transactionJSON, err := ctx.GetStub().GetState(transactionId)
    if err != nil || transactionJSON == nil {
        return fmt.Errorf("transaction not found: %s, error: %v", transactionId, err)
    }

    // Unmarshal the JSON into the DataTransaction struct
    var transaction DataTransaction
    err = json.Unmarshal(transactionJSON, &transaction)
    if err != nil {
        return fmt.Errorf("failed to unmarshal transaction data: %v", err)
    }

    // Update the transaction record with the new IPFS CID
    transaction.IPFSCID = cid

    // Marshal the updated transaction struct back into JSON
    updatedTransactionJSON, err := json.Marshal(transaction)
    if err != nil {
        return fmt.Errorf("failed to marshal updated transaction: %v", err)
    }

    // Update the ledger with the new transaction data
    return ctx.GetStub().PutState(transactionId, updatedTransactionJSON)
}


// CreateInvoiceUsingIPFS handles the creation of an invoice for a data access fee, utilizing IPFS for data storage
func (dtc *DataTransactionContract) CreateInvoiceUsingIPFS(ctx contractapi.TransactionContextInterface, transactionID string, transactionValue FabToken) error {
    // Create invoice data
    invoiceData := fmt.Sprintf("Invoice for transaction %s: %s", transactionID, transactionValue)

    // Store invoice on IPFS and get the CID
    cid, err := sh.Add(strings.NewReader(invoiceData))
    if err != nil {
        return fmt.Errorf("failed to create invoice on IPFS: %v", err)
    }

    // Retrieve the existing transaction record from the ledger using the transaction ID
    transactionJSON, err := ctx.GetStub().GetState(transactionID)
    if err != nil || transactionJSON == nil {
        return fmt.Errorf("transaction not found: %s, error: %v", transactionID, err)
    }

    // Unmarshal the JSON into the DataTransaction struct
    var transaction DataTransaction
    err = json.Unmarshal(transactionJSON, &transaction)
    if err != nil {
        return fmt.Errorf("failed to unmarshal transaction data: %v", err)
    }

    // Update the transaction record with the invoice CID
    transaction.IPFSCID = cid

    // Marshal the updated transaction struct back into JSON
    updatedTransactionJSON, err := json.Marshal(transaction)
    if err != nil {
        return fmt.Errorf("failed to marshal updated transaction: %v", err)
    }

    // Update the ledger with the new transaction data
    return ctx.GetStub().PutState(transactionID, updatedTransactionJSON)
}
// UpdateLedgerWithInvoiceCID handles updating the ledger with a transaction's invoice IPFS CID
func (dtc *DataTransactionContract) UpdateLedgerWithInvoiceCID(ctx contractapi.TransactionContextInterface, transactionID string, ipfsCID string) error {
    // Retrieve the existing transaction record from the ledger using the transaction ID
    transactionJSON, err := ctx.GetStub().GetState(transactionID)
    if err != nil || transactionJSON == nil {
        return fmt.Errorf("transaction not found: %s, error: %v", transactionID, err)
    }

    // Unmarshal the JSON into the DataTransaction struct
    var transaction DataTransaction
    err = json.Unmarshal(transactionJSON, &transaction)
    if err != nil {
        return fmt.Errorf("failed to unmarshal transaction data: %v", err)
    }

    // Update the transaction record with the invoice CID
    transaction.IPFSCID = ipfsCID

    // Marshal the updated transaction struct back into JSON
    updatedTransactionJSON, err := json.Marshal(transaction)
    if err != nil {
        return fmt.Errorf("failed to marshal updated transaction: %v", err)
    }

    // Update the ledger with the new transaction data
    return ctx.GetStub().PutState(transactionID, updatedTransactionJSON)
}


func (dtc *DataTransactionContract) PaymentTransaction(ctx contractapi.TransactionContextInterface, transactionID string, invoiceDate string, transactionValue FabToken) error {
    currentDate := GetCurrentDate() 
    // Retrieve the existing transaction record from the ledger using the transaction ID
    transactionJSON, err := ctx.GetStub().GetState(transactionID)
    if err != nil || transactionJSON == nil {
        return fmt.Errorf("transaction not found: %s, error: %v", transactionID, err)
    }
    var transaction DataTransaction
    err = json.Unmarshal(transactionJSON, &transaction)
    if err != nil {
        return fmt.Errorf("failed to unmarshal transaction data: %v", err)
    }
    // Check if the current date matches the invoice date and the transaction is for a Data Access Fee
    if currentDate == invoiceDate && transaction.TransactionType == "Data Access Fee" {
        // Create invoice using IPFS
        cid, err := dtc.CreateInvoiceUsingIPFS(ctx, transactionID, transactionValue)
        if err != nil {
            return fmt.Errorf("failed to create invoice using IPFS: %v", err)
        }
        // Update ledger with the new invoice CID
        err = dtc.UpdateLedgerWithInvoiceCID(ctx, transactionID, cid)
        if err != nil {
            return fmt.Errorf("failed to update ledger with invoice CID: %v", err)
        }

        return nil
    }

    return fmt.Errorf("conditions not met for processing payment transaction: %s", transactionID)
}

// ApplyLatePaymentChargeUsingIPFS handles applying a late payment charge with reference to data on IPFS
func (dtc *DataTransactionContract) ApplyLatePaymentChargeUsingIPFS(ctx contractapi.TransactionContextInterface, 
transactionID string, paymentDueDate string, latePaymentChargeRate float64) error {

    currentDate := GetCurrentDate() 

    // Retrieve the existing transaction record from the ledger using the transaction ID
    transactionJSON, err := ctx.GetStub().GetState(transactionID)
    if err != nil || transactionJSON == nil {
        return fmt.Errorf("transaction not found: %s, error: %v", transactionID, err)
    }
    var transaction DataTransaction
    err = json.Unmarshal(transactionJSON, &transaction)
    if err != nil {
        return fmt.Errorf("failed to unmarshal transaction data: %v", err)
    }

    // Check if the current date is past the payment due date and payment is outstanding
    if currentDate > paymentDueDate && PaymentIsOutstanding(transactionID) { 
        // Calculate the late payment charge based on the rate
        lateCharge := CalculateLateCharge(transaction.TransactionValue, latePaymentChargeRate) 

        // Create late payment details and store on IPFS, then update the transaction record with new IPFS CID
        latePaymentDetails := fmt.Sprintf("Late payment charge for transaction %s: %f", transactionID, lateCharge)
        cid, err := sh.Add(strings.NewReader(latePaymentDetails))
        if err != nil {
            return fmt.Errorf("failed to store late payment details on IPFS: %v", err)
        }

        transaction.IPFSCID = cid 
        updatedTransactionJSON, err := json.Marshal(transaction)
        if err != nil {
            return fmt.Errorf("failed to marshal updated transaction: %v", err)
        }

        return ctx.GetStub().PutState(transactionID, updatedTransactionJSON)
    }

    return nil 
}

func CalculateLateCharge(transactionValue int, latePaymentChargeRate float64) int {
    lateCharge := float64(transactionValue) * latePaymentChargeRate
    return int(lateCharge + 0.5) 
}

func main() {
    chaincode, err := contractapi.NewChaincode(new(DataTransactionContract))

    if err != nil {
        fmt.Printf("Error create dataTransactions chaincode: %s", err.Error())
        return
    }

    if err := chaincode.Start(); err != nil {
        fmt.Printf("Error starting dataTransactions chaincode: %s", err.Error())
    }
}
