package dataasset

type DataAssetContract struct {
    contractapi.Contract
}
type DataAsset struct {
    AssetID           string `json:"assetId"`
    AssetType         string `json:"assetType"`
    AssetValue        int `json:"assetValue"`
    AnonymizationLevel string `json:"anonymizationLevel"`\
    LegiCoin          FabToken `json:"legiCoin"`
}

func (dac *DataAssetContract) ProvideDataAsset(ctx contractapi.
TransactionContextInterface, assetID string, anonymizationLevel string) error {

    agreementIsActive := dac.AgreementIsActive(ctx) 
    
    
    assetValue, err := dac.GetAssetValue(ctx, assetID)
    if err != nil {
        return fmt.Errorf("error retrieving asset value: %s", err)
    }
  
    assetValueValid := assetValue > 0 
    anonymizationLevelValid := anonymizationLevel == "GDPR_32" 

    if agreementIsActive && assetValueValid && anonymizationLevelValid {
        
        err := dac.UpdateAsset(ctx, assetID, anonymizationLevel)
        if err != nil {
            return fmt.Errorf("error updating data asset: %s", err)
        }
        return nil
    } else {
          
        return fmt.Errorf("conditions not met for providing data asset: %s", assetID)
    }
}


